RewriteEngine On

# Home
RewriteRule ^$ index.html [L]

# Sirve internamente /archivo -> /archivo.html si existe.
# Se evita redirección canónica para mayor compatibilidad en hosting compartido.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
